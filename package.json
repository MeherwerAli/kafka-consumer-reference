{
  "name": "@meherwerali/kafka-consumer-reference",
  "version": "0.1.0",
  "description": "A failure-aware TypeScript Kafka consumer with manual commits, dead-letter handling, and idempotent processing boundaries.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "prepack": "npm run build",
    "start": "node lib/main.js",
    "dev": "tsx src/main.ts"
  },
  "keywords": [
    "kafka",
    "kafkajs",
    "typescript",
    "idempotency",
    "dead-letter-queue"
  ],
  "author": "Meherwer Ali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeherwerAli/kafka-consumer-reference.git"
  },
  "homepage": "https://github.com/MeherwerAli/kafka-consumer-reference#readme",
  "bugs": {
    "url": "https://github.com/MeherwerAli/kafka-consumer-reference/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
